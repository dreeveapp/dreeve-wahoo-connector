# Wahoo API Credentials (from https://developers.wahooligan.com/applications)
WAHOO_CLIENT_ID=your_wahoo_client_id_here
WAHOO_CLIENT_SECRET=your_wahoo_client_secret_here
WAHOO_REDIRECT_URI=https://localhost:8085/callback

# Sync Settings
SYNC_TIME_WINDOW=1_week
SYNC_CRON=0 2 * * *

# Web Server Port (default: 8085)
PORT=8085

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Directory Paths (Optional Overrides)
# DATA_DIR=/data
# STATE_DIR=/data/config
# WATCH_DIR=/data/downloads
